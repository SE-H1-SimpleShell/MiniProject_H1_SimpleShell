@startuml Architecture
!pragma layout smetana

skinparam shadowing false
skinparam defaultFontName "Segoe UI"
skinparam roundCorner 8
skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam ArrowColor #4A5568
skinparam ComponentBackgroundColor #EBF4FF
skinparam ComponentBorderColor #2B6CB0
skinparam PackageBackgroundColor #F7FAFC
skinparam PackageBorderColor #718096
skinparam LegendBackgroundColor #FFFBE6
skinparam LegendBorderColor #B7791F

title Simple Shell - Component and Layered Architecture

actor "User" as user

package "Simple Shell (C11 / POSIX)" as app {

  component "main.c\nEntry point" as main
  component "shell.c\nREPL & Event Multiplexing\nshell_loop() / poll() / self-pipe" as shell
  component "parser.c\nLexer & Pre-validation\nparse_line() / free_pipeline()" as parser
  component "executor.c\nProcess Execution Engine\nexecute_pipeline() / reap_background()" as executor
  component "builtins.c\nBuilt-in Commands\nis_builtin() / run_builtin()" as builtins
  database "Parser data model\nstruct Pipeline\nstruct Command" as model

}

package "C standard library" as libc {
  component "malloc / free\nstrlen / memcpy\nsnprintf" as memlib
}

package "Operating system (POSIX)" as os {
  component "Process control & Signals\nfork / execvp / waitpid\nsigaction (SIGCHLD)" as proc
  component "I/O, Pipes & Multiplexing\npipe / dup2 / poll / open / close" as io
  component "Filesystem and environment\nchdir / getcwd / PATH lookup" as fs
}

user --> shell : command line
main --> shell : starts
shell --> parser : parse_line()
parser --> model : builds
shell --> executor : execute_pipeline()
shell --> model : owns / frees
executor --> model : reads
executor --> builtins : is_builtin() / run_builtin()
executor --> proc : spawn and wait
executor --> io : redirect and pipe
builtins --> fs : cd / pwd
parser --> memlib : allocate / release
proc --> shell : SIGCHLD notification via self-pipe

legend right
  <b>Enforced parser limits</b>
  MAX_ARGS = 128 arguments
  MAX_PIPE_SEGMENTS = 32 stages
  Rejects unterminated quotes, trailing escapes,
  duplicate redirections and multiple & operators.

  <b>Execution model</b>
  - Foreground pipelines wait for all stages.
  - SIGCHLD handler writes to self-pipe;
    reaped asynchronously via poll() and waitpid().
  - Single foreground built-ins run in parent (cd, exit);
    built-ins in pipelines run in child processes.
endlegend

@enduml
